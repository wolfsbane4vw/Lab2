# Copy this file to terraform.tfvars and enter the AMI ID from Lab1's
# Packer output or manifest.json. Use the region where that AMI was built.
project_name  = "lab2"
aws_region    = "eu-north-1"
ami_id        = "ami-REPLACE_WITH_LAB1_AMI_ID"
instance_type = "t3.small"
ssh_cidr      = "YOUR_PUBLIC_IP/32"

